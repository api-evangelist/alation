{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alation Data Catalog Aggregated Context Columns API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Columns",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List columns",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}/integration/v2/attribute/",
            "params": [
              {
                "name": "table_id",
                "value": "",
                "type": "query",
                "description": "Table ID to filter columns"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "skip",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns columns for a given table."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alation Data Catalog Aggregated Context API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Aggregated Context",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get aggregated context",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}/integration/v2/aggregated_context/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieves relevant catalog context for a given query or set of objects, optimized for AI and LLM consumption."
        }
      ]
    }
  ],
  "bundled": true
}
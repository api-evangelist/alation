{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alation Data Catalog Aggregated Context Dataflows API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Dataflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List dataflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}/integration/v2/dataflow/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "skip",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of all dataflow objects."
        },
        {
          "info": {
            "name": "Create a dataflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}/integration/v2/dataflow/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new dataflow object representing a lineage path."
        },
        {
          "info": {
            "name": "Get a dataflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}/integration/v2/dataflow/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns details for a specific dataflow object."
        },
        {
          "info": {
            "name": "Update a dataflow",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{instance}/integration/v2/dataflow/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing dataflow object."
        },
        {
          "info": {
            "name": "Delete a dataflow",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{instance}/integration/v2/dataflow/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a dataflow object and its associated lineage paths."
        }
      ]
    }
  ],
  "bundled": true
}
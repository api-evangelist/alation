{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alation Data Catalog Aggregated Context Policies API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Policies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List policies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}/integration/v2/policy/",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "skip",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns governance policies from the Alation catalog."
        },
        {
          "info": {
            "name": "Create a policy",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}/integration/v2/policy/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new governance policy."
        },
        {
          "info": {
            "name": "Get a policy",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}/integration/v2/policy/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a policy"
        }
      ]
    }
  ],
  "bundled": true
}